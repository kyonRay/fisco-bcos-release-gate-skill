# Example regression case — a flywheel fixture, not a captured production incident. Demonstrates
# the .case format; see scenarios/README.md for the field reference and the flywheel flow.
[case]
status = example
profile = default-latest
input = "${OPS_BIN:-$FISCO_BIN}" sysconfig get tx_count_limit --node-dir "$NODE_DIR/node0" --json
expect_oracle = pass
